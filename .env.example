DASHBOARD_TITLE="Infraestrutura Proxmox"
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=SUBSTITUA
DASHBOARD_SESSION_SECRET=SUBSTITUA
DASHBOARD_DEFAULT_THEME=system
DASHBOARD_ENV_FILE=/etc/proxmox-pbs-dashboard/dashboard.env
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080
REFRESH_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15
MAX_PARALLEL_GUEST_AGENT_REQUESTS=8

# Todos os PVEs ficam neste mesmo ENV. Use a página Configurações para editar.
PVE_INSTANCES_JSON="[{\"id\":\"pve1\",\"name\":\"PVE Principal\",\"url\":\"https://pve01.exemplo.local:8006\",\"token_id\":\"dashboard@pve!readonly\",\"token_secret\":\"SUBSTITUA\",\"verify_tls\":false}]"

PBS_URL=https://pbs01.exemplo.local:8007
PBS_TOKEN_ID=dashboard@pbs!readonly
PBS_TOKEN_SECRET=SUBSTITUA
PBS_DATASTORES=backup-prod
PBS_NODE=localhost
PBS_VERIFY_TLS=false
PBS_TASK_LIMIT=500

# Para múltiplos PBS, use uma lista JSON no mesmo formato dos PVE.
# PBS_INSTANCES_JSON="[{\"id\":\"pbs1\",\"name\":\"PBS Principal\",\"url\":\"https://pbs01.exemplo.local:8007\",\"token_id\":\"dashboard@pbs!readonly\",\"token_secret\":\"SUBSTITUA\",\"datastores\":\"backup-prod\",\"node\":\"localhost\",\"verify_tls\":false}]"

IP_OVERRIDES_FILE=/etc/proxmox-pbs-dashboard/ip-overrides.json
IP_CACHE_FILE=/var/lib/proxmox-pbs-dashboard/ip-cache.json
NOTES_FILE=/var/lib/proxmox-pbs-dashboard/notes.json
EXCLUDED_INTERFACE_PREFIXES=lo,docker,veth,br-,virbr,podman,cni,tun,tap,wg,tailscale,zt
